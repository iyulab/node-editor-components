{
  "name": "@iyulab/editor-components",
  "description": "various editor components by iyulab",
  "version": "0.0.1",
  "keywords": [
    "iyulab",
    "web-components",
    "lit-element"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-editor-components.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./dist/*": {
      "types": "./src/*.d.ts",
      "import": "./src/*"
    }
  },
  "scripts": {
    "start": "vite",
    "build": "eslint && vite build"
  },
  "dependencies": {
    "@iyulab/components": "0.1.11",
    "lit": "^3.3.2",
    "monaco-editor": "^0.55.1",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@lit/react": "^1.0.8",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.8",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}