{
  "name": "@iyulab/editor-components",
  "description": "various editor components by iyulab",
  "version": "0.4.0",
  "keywords": [
    "iyulab",
    "web-components",
    "lit-element"
  ],
  "license": "MIT",
  "author": "iyulab",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-editor-components.git"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/components/*/U*.js",
    "./src/components/*/U*.ts",
    "./dist/index.js",
    "./src/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./dist/*": {
      "types": "./src/*.d.ts",
      "import": "./src/*"
    }
  },
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "preview": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "npm run typecheck && eslint && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "quill": "^2.0.3"
  },
  "peerDependencies": {
    "@iyulab/components": ">=1.15.0",
    "@lit/react": ">=1.0.8",
    "react": ">=18.0.0",
    "monaco-editor": "^0.55.1"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.1.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
